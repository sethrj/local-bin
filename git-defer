#!/bin/sh -e

detach=false
if [ -z "$1" ]; then
    branch_name="$(git rev-parse --abbrev-ref HEAD)"
    printf "Deferring current branch '%s'\n" "$branch_name" >&2
    detach=true
fi

for branch_name in "$@"; do
    if git rev-parse --verify "$branch_name" >/dev/null 2>&1; then
        git branch -m "$branch_name" "defer/$branch_name"
    else
      printf "Warning: no branch n'%s'\n" "$branch_name" >&2
    fi
done

if $detach; then
    git checkout --detach HEAD
fi