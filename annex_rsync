#!/bin/bash

if [ -z "$1" ]; then
  echo "Syntax: annex_rysnc SERVER"
  echo "Copy local annex files (excluding silo) to SERVER:$pwd"
  exit 2
fi

basepath=$(git rev-parse --show-toplevel)
remotepath=$(echo $basepath | sed -e "s:$HOME:~:")
annexpath=".git/annex/objects/"
server="$(whoami)@$1"

#ssh $SERVER mkdir -p $REMOTEPATH 2>/dev/null
echo "Syncing files from $basepath/$annexpath to $server:$remotepath/$annexpath"
rsync -v -rptlgo --exclude="*.silo" \
  $basepath/$annexpath \
  $server:$remotepath/$annexpath

