# Start using Py3k-like functions
from __future__ import (division, absolute_import, print_function,
        unicode_literals)
###############################################################################

from datetime import datetime
import os
import re
import sys

template_root = os.path.join(os.environ['HOME'], "_code", "srjutils",
        "templates")
now = datetime.now()
username = os.environ['LOGNAME']

has_format_re = re.compile(r'\{.*\}')

################################################################################
class FileGenerator(object):
    def __init__(self, filename, **kwargs):
        # Save the absolute path for later writing
        self.reloutpath = filename
        self.outpath = os.path.abspath(filename)

        # Construct the local path for the last few directories
        head = self.outpath
        localpath = []
        path_count = 0
        while path_count < 2:
            (head, tail) = os.path.split(head)
            localpath.append(tail)
            if tail not in ("test", "tests", "scripts", "python"):
                path_count += 1
        # Join path components together
        localpath = os.path.join(*localpath[::-1])

        # Separate filename component into base.ext
        (base, ext) = os.path.splitext(os.path.basename(filename))
        self.ext = ext

        # Build dictionary of substitutions
        self.subs = kwargs
        self.subs.update({
                'username': username,
                'datetime': now.strftime("%a %b %d %H:%M:%S %Y"),
                'date'    : now.strftime("%B %d, %Y"),
                'filename': localpath,
                'base'    : base,
                'ext'     : ext,
                })

    def write(self):
        # Check for template
        inpath = os.path.join(template_root, "template" + self.ext)
        self.inpath = inpath
        if not os.path.exists(inpath):
            print("FATAL: Couldn't open template file at '{}'".format(inpath),
                    file=sys.stderr)
            sys.exit(1)

        outpath = self.outpath
        if os.path.exists(outpath):
            print("FATAL: File at {} already exists".format(outpath),
                    file=sys.stderr)
            sys.exit(1)

        # Load the template, create the new file
        with open(inpath, 'rU') as infile:
            with open(outpath, 'w') as outfile:
                self._write(infile, outfile)

        print("Sucessfully created {}".format(self.reloutpath),
                file=sys.stderr)

    def _write(self, infile, outfile):
        subs = self.subs
        unknown_keys = set()
        for (i, line) in enumerate(infile):
            try:
                line = line.format(**subs)
            except KeyError as e:
                unknown_keys.add(str(e))
            except ValueError as e:
                print("WARNING: Formatting error in line {d} of {}: {}".format(
                    i, self.inpath, e), file=sys.stderr)
                if "Single '{' encountered" in str(e):
                    print("In the template file, replace '{' with '{{'",
                        file=sys.stderr)

            outfile.write(line)

        if unknown_keys:
            print("WARNING: missing the following keys: {}".format(
                ", ".join(sorted(unknown_keys))) , file=sys.stderr)


################################################################################
def main(args=None):
    if args is None:
        args = sys.argv[1:]

    kwargs       = {}
    short_kwargs = {}
    filenames    = []

    args = iter(args)
    for a in args:
        if a.startswith('--'):
            # Check arguments of type --key value or --key=value
            k = a.replace('--', '')
            if not k:
                # Just '--' means end of kwargs
                break
            elif "=" in k:
                (k,v) = a.split('=')
            else:
                v = next(args)
            kwargs[k] = v
        elif a.startswith('-'):
            # Check arguments of type -k value
            k = a.replace('-', '')
            v = next(args)
            short_kwargs[k] = v
        else:
            # kwargs are done
            filenames.append(a)
            break

    # Grab following filenames
    for a in args:
        filenames.append(a)

    if short_kwargs:
        print("FATAL: short kwargs are not yet supported", file=sys.stderr)
        sys.exit(1)

    # Create files
    for fn in filenames:
        gen = FileGenerator(fn)
        gen.write()

#-----------------------------------------------------------------------------#
if __name__ == '__main__':
    main()

