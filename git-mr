#!/bin/sh -e
#
# This fetches a merge request from the upstream gitlab repo:
#
#   git mr 421
#
# will fetch merge request !421.

usage () {
  echo "Usage: $0 [remote] mrid" 1>&2
  exit 2
}

case $# in
  1) REMOTE=upstream MR=$1;;
  2) REMOTE=$1 MR=$2;;
  *) usage ;;
esac

URL=$(git config --get remote.${REMOTE}.url)

if [[ "${URL}" =~ "github.com" ]]; then
  ROOT=pull
else
  ROOT=merge-requests
fi

REMOTE_BRANCH="${ROOT}/${MR}/head"
LOCAL_BRANCH="mr/${REMOTE}-${MR}"
git fetch ${REMOTE} ${REMOTE_BRANCH}:${LOCAL_BRANCH}
git checkout ${LOCAL_BRANCH}
git config set branch.${LOCAL_BRANCH}.merge ${REMOTE_BRANCH}
git config set branch.${LOCAL_BRANCH}.remote ${REMOTE}
git config set branch.${LOCAL_BRANCH}.pushRemote ${REMOTE}
