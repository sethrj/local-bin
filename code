set -e

VSCODE="/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"

if [ $# -eq 0 ]; then
  GITDIR="$(git rev-parse --show-toplevel)"
  printf "code %s\n" "${GITDIR}" >&2
  exec "${VSCODE}" "${GITDIR}"
fi

exec "${VSCODE}" "$@"
