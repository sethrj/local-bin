nowtime = int(time.time())
gitcmd = "git"

def call_git(*args):
    try:
        output = subprocess.check_output((gitcmd,) + args)
    except subprocess.CalledProcessError as e:
        raise
    return output

def get_xattr_path():
    git_base_path = os.environ.get('GIT_DIR', None)
    if not git_base_path:
        git_base_path = call_git("rev-parse", "--git-dir").strip()

    # Old gitxattr
    #git_base_path = os.path.abspath(os.path.join(git_base_path, '..'))
    #path = os.path.join(git_base_path, '.gitxattr_json')

    return os.path.join(git_base_path, "xattr.json")

xattr_path = get_xattr_path()

#******************************************************************************#
def xattr_to_dict(xa):
    return dict((k, binascii.b2a_base64(v)) for (k, v) in xa.iteritems())

def xattr_key_decode(txt):
    return binascii.a2b_base64(txt)

#******************************************************************************#

# status is Added (A), Copied (C), Deleted (D), Modified (M), Renamed (R),
# have their type (i.e. regular file, symlink, submodule, ...) changed (T),
# are Unmerged (U), are Unknown (X), or have had their pairing Broken (B)
changed_statuses = ('M','A','C','T','X')

def git_name_status(*args):
    gitoutput = call_git("diff", "--name-status", "-z", *args)
    # Split the zero-delimited result into a flattened list
    data = gitoutput.split('\x00')
    # Turn the list into pairs (also gets rid of last empty value)
    data = zip(data[0::2], data[1::2])

    return data

def get_directory_names():
    """Add directories in pwd to the list of filenames"""
    dirnames = []
    for root, dirs, files in os.walk('.'):
        # Don't walk through invisibles
        dirs[:] = [dn for dn in dirs if dn[0] != '.']
        # Add dirs to the list of attributes
        dirnames.extend(os.path.join(root, dn) for dn in dirs)

    return dirnames

#******************************************************************************#
# LOADING AND SETTING INDIVIDUAL FILE XATTRS
# _yellow_color = xattr_key_decode("AAAAAAAAAAAACgAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=\n")
# _green_color  = xattr_key_decode("AAAAAAAAAAAABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=\n")

def load_xattr_into_dict(path, filedatadict):
    dat = {}
    if not os.path.exists(path):
        print "Can't load xattr for file '%s' because it doesn't exist." % (
                path)
        return
    xa = xattr.xattr(path)

    # Set default colors
    #if path.endswith("CMakeLists.txt") or path.endswith(".cmake"):
    #if path.endswith("CMakeLists.txt"):
    #    # Set CMake finder color
    #    xa['com.apple.FinderInfo'] = _yellow_color
    #elif path.endswith(".i"):
    #    # Set SWIG finder color
    #    xa['com.apple.FinderInfo'] = _green_color

    if xa:
        # store new xattributes
        dat['xattrs'] = xattr_to_dict(xa)

    if path in filedatadict:
        dat['creation'] = filedatadict[path]['creation']
    elif os.path.isdir(path):
        # get creation date from path itself (ctime/metadata change)
        dat['creation'] = os.stat(path)[-1]
    else:
        # load creation date: check git repo history
        #gitoutput = call_git("log", "--format=%at", "--follow", "--", path,)
        # Use last modification date instead of creation date for speed
        gitoutput = call_git("log", "--format=%at", "-1", "--", path,)
        if (gitoutput):
            dat['creation'] = int(gitoutput.split('\n')[-2])
        else:
            try:
                print "NOTICE: Had to stat file '%s'" % path
                # get creation date from path itself (ctime/metadata change)
                dat['creation'] = os.stat(path)[-1]
            except OSError, e:
                print "NOTICE: Error trying to stat file '%s'" % path
                dat['creation'] = nowtime

    # Set the dictionary attribute
    filedatadict[path] = dat
    #print "Set path ", path, "data:", dat

def apply_file_attr(path, filedatadict):
    if not os.path.exists(path):
        #print "Deleting now-defunct path '%s'" % path
        #del filedatadict[path]
        return
    if not path in filedatadict:
        #print "path '%s' was unexpectedly not in .gitxattr" % path
        load_xattr_into_dict(path, filedatadict)
        return
    data = filedatadict[path]
    # Set date: (access, modified) ; or on mac (created, modified)
    try:
        os.utime(path, (data['creation'], data['creation']))
    except OSError, e:
        print "Couldn't apply attributes to file '%s'" % path
        return

    os.utime(path, (nowtime, nowtime))

    # set xattrs
    try:
        storedxa = data['xattrs']
    except KeyError:
        storedxa = {}
    xa = xattr.xattr(path)
    extraneous = set(xa) - set(storedxa)
    # delete extraneous xattrs
    for k in extraneous:
        del xa[k]
    # set all existing keys
    for k in storedxa:
        xa[k] = xattr_key_decode(storedxa[k] )


#******************************************************************************#
# MANUAL RESET OF METADATA
def build_initial_attr():
    """Loads (and overwrites) all existing attributes"""
    print "Loading and replacing all attributes."
    filedatadict = {}
    gitoutput = call_git("ls-files", "--cached","-z",)

    # Get all file names
    filenames = gitoutput.split('\x00')[:-1]
    filenames.extend(get_directory_names())
    status_stride = max(50, len(filenames) / 20)
    for (i, path) in enumerate(filenames):
        if not i % status_stride:
            print "Completed %d/%d [current: '%s']" % (i, len(filenames), path)
        load_xattr_into_dict(path, filedatadict)
    return filedatadict

def force_update_attr(filedatadict):
    """Removes nonexistent attributes and updates new ones"""
    print "Forcing update."
    gitoutput = call_git("ls-files", "--cached","-z",)
    filenames = gitoutput.split('\x00')[:-1]
    filenames.extend(get_directory_names())

    for path in set(filedatadict) - set(filenames):
        print "deleting key", path
        del filedatadict[path]
    for path in filenames:
        #print "Loading xattrs for", path
        load_xattr_into_dict(path, filedatadict)

def force_apply_all(filedatadict):
    for filename in filedatadict:
        apply_file_attr(filename, filedatadict)

#******************************************************************************#
# MERGE OTHER .gitxattr
def resolve_merge(head_datadict, xattr_filename):
    print "Trying to resolve merge"
    gitoutput = call_git("show", ":3:" + xattr_filename,)
    # load other branch's xattr database
    remote_datadict = json.load(gitoutput.stdout)

    # see what new files we're adding from the other branch
    added_keys = set(remote_datadict) - set(head_datadict.keys())
    # apply attributes to those files
    for filename in added_keys:
        apply_file_attr(filename, remote_datadict)

    # update our dictionary
    head_datadict.update(remote_datadict)

#******************************************************************************#
# STORING DATA FOR ADDED FILES ON COMMIT
def store_committed_attr(filedatadict):
    data = git_name_status("--cached" )
    #print "(status, filename):", data
    # Apply to each result
    for (status, filename) in data:
        if status[0] in changed_statuses:
            load_xattr_into_dict(filename, filedatadict)
        elif status[0] == 'R':
            #print "NOTICE: renamed a file '%s'" % filename
            # set old key to new?
            pass
        elif status[0] == 'D':
            try:
                del filedatadict[filename]
            except KeyError:
                print ("Warning: it seems like file '%s'"
                        "was missing from the database. But that's ok because"
                        "we're deleting it anyway." % filename)

    return

def do_commit(filedatadict):
    gitoutput = call_git("log", "-n", "1", "--format=%s%n%b")
    if "Merge branch" == gitoutput[:12] and "Conflicts:" in gitoutput:
        print ("Detecting merge of conflicted branch; doing apply_merge "
                "rather than store_committed_attr")
        apply_merge(filedatadict)
    else:
        store_committed_attr(filedatadict)

#******************************************************************************#
# APPLYING ON CHECKOUT/MERGE
def apply_merge(filedatadict, *args):
    try:
        if args and args[0] == "amend":
            data = git_name_status("HEAD^", "HEAD" )
        else:
            data = git_name_status("ORIG_HEAD", "HEAD" )
    except subprocess.CalledProcessError as e:
        print "Couldn't get name status", e
        print "Args:", args
        return

    for (status, filename) in data:
        if status[0] in changed_statuses:
            apply_file_attr(filename, filedatadict)

def apply_checkout(filedatadict, *args):
    (oldref, newref, isBranchCheckout) = args
    #print "Apply_checkout args:", args
    data = git_name_status(oldref, newref)
    #print "(status, filename)", data

    for (status, filename) in data:
        if status[0] in changed_statuses:
            apply_file_attr(filename, filedatadict)

#******************************************************************************#
def print_files(filedatadict):
    print "Files in '%s':" % xattr_path
    print "\n".join(sorted(filedatadict))

#******************************************************************************#
# POSSIBLE HOOK EVENTS:
#  - init: calculate all info about repository, write it to .gitxattr
#  - pre-commit: add attributes from newly added files
#  - post-checkout: revert attributes
#  - post-merge: revert attributes

def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]

    tasks = {
            'apply'        : force_apply_all,
            'reset'        : lambda data: None,
            'update'       : force_update_attr,
            'print'        : print_files,
            'resolve'      : resolve_merge,
            'pre-commit'   : do_commit,
            'post-merge'   : apply_merge,
            'post-rewrite' : apply_merge,
            'post-checkout': apply_checkout,
            }

    if len(argv) < 1:
        print "Usage: %s [%s] [args]" % (sys.argv[0],
                " | ".join(sorted(tasks)))
        sys.exit(2)

    task = argv[0]
    if task not in tasks:
        print "Invalid task '%s': choose one of %s" % (task,
                ", ".join(sorted(tasks)))
        sys.exit(1)

    ### LOAD XATTR DATA
    needs_write = False
    if not os.path.isfile(xattr_path):
        print "xattr file '%s' not found; initializing" % xattr_path
        xattr_data_dict = build_initial_attr()
        needs_write = True
    elif task == "reset":
        xattr_data_dict = build_initial_attr()
        needs_write = True
    else:
        # try opening the file
        with open(xattr_path) as data_file:
            # load old data into dict; if nonexistent, set dict to empty
            xattr_data_dict = json.load(data_file)
        if task in ("pre-commit", "update", "resolve"):
            needs_write = True

    ### CALL FUNCTION
    fn = tasks[task]
    fn(xattr_data_dict, *argv[1:])

    ### WRITE XATTR DATA
    if needs_write:
        #print "Rewriting '%s' and adding to commit" % xattr_path
        # write new data
        with open(xattr_path, 'wb') as outfile:
            #json.dump(xattr_data_dict, outfile)
            json.dump(xattr_data_dict, outfile, indent=0, sort_keys=True)
        #call_git("add", xattr_path)

################################################################################
if __name__ == '__main__':
    main()
