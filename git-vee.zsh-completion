#compdef git-vee

# NOTE: for zsh integration, symlink to:
# ~/.oh-my-zsh/custom/completions/_git-vee

_git-vee() {
  local -a branches
  
  _arguments -s -S \
    '-h[Exclude HEAD from refs]' \
    '*:branch:->branches'
  
  case $state in
    branches)
      branches=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads/ 2>/dev/null)"})
      _describe 'branch' branches
      ;;
  esac
}

_git-vee "$@"
