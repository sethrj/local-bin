#!/bin/sh -e
#
# This shows the graphical relationship between a bunch of input refs.

usage () {
  echo "Usage: $0 [ref [...]] " >&2
}

if [ $# -eq 0 ]; then
  usage; exit 2
fi

default="HEAD"
while getopts "h" opt; do
  case "${opt}" in
    h) default= ;;
    \?) echo "Invalid option: -$OPTARG" >&2; exit 1 ;;
    *) usage; exit 2 ;;
  esac
done
shift $((OPTIND-1))

set +x

merge_base=$(git merge-base "$@" $default)

exec git log \
  --decorate --cherry-mark --oneline --graph --boundary \
  "$@" $default ^${merge_base}
