#!/usr/bin/env python

from argparse import ArgumentParser
import logging as log
import os
from subprocess import check_call
import sys

hostname = os.uname()[1]
default_other = "sethjmacpro"
if default_other in hostname:
    default_other = "sierrajuliet"

def scp(source, dest, paths, pwd=None):
    log.info("Copying from %s to %s:", source, dest)
    if pwd is None:
        pwd = os.getcwd()

    if source == hostname:
        source = ""
    dest = dest + ":"

    for p in paths:
        p = os.path.join(pwd, p)
        # -E is mac flag for copying extended attributes
        cmd = ("scp", "-E", "-p",
                source + p, dest + p)
        #print cmd
        check_call(cmd)

def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]

    parser = ArgumentParser("Send files between same locations on computers")

    parser.add_argument("--from",
            action="store_const", const="from", dest="which",
            default="from",
            help="Send from this computer",)

    parser.add_argument("--to",
            action="store_const", const="to", dest="which",
            help="Send to this computer",)

    parser.add_argument('files', nargs='+')

    result = parser.parse_args(argv)

    if result.which == "from":
        (source, dest) = (hostname, default_other)
    else:
        (source, dest) = (default_other, hostname)

    scp(source, dest, result.files, os.getcwd())

################################################################################
if __name__ == '__main__':
    main()

