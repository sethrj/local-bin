#
# Move annexed files from the git annex repository. You probably have to
# `chmod -R a+w .git/annex` to get it to work.
from __future__ import print_function

import os
import subprocess

def get_files():
    # Get all git status/blob/filename in the current directory
    files = subprocess.check_output(['git','ls-tree','-r','HEAD'])
    # Extract the filenames
    files = [line[53:] for line in files.split('\n') if line]
    return files

def replace_file(symlink_path):
    # Get the absolute path of the file pointed to by the symlink
    real_path = os.path.realpath(symlink_path)
    # Move original file to where the symlink used to be
    if '.git/annex/objects' in real_path:
        if os.path.exists(real_path):
            print("Replacing", symlink_path, "with original", real_path)
            os.remove(symlink_path)
            os.rename(real_path, symlink_path)
        else:
            print("Skipping symlink at", symlink_path)

def run():
    files = get_files()
    for path in files:
        if os.path.islink(path):
            replace_file(path)

if __name__ == '__main__':
    run()

